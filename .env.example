# Copia este archivo a .env y ajusta según tu entorno.
#
# Por default la app apunta al backend de Railway en producción.
# Si quieres apuntar a tu backend local, descomenta y ajusta la IP:

# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Cómo encontrar tu IP local:
#   Windows: ipconfig → IPv4 Address del adaptador WiFi
#   Mac/Linux: ifconfig | grep inet
