{
  "expo": {
    "name": "SICE Operador",
    "slug": "sice-operador",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sice",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.sice.operador",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SICE necesita la cámara para tomar foto del documento como evidencia probatoria de la entrega."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SICE captura tu ubicación al momento de registrar la entrega como evidencia de campo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://sice-backend-production.up.railway.app",
      "apiUrlDev": "http://10.0.2.2:4000"
    }
  }
}
