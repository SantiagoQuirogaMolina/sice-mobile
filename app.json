{
  "expo": {
    "name": "SICE Operador",
    "slug": "sice-operador",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sice",
    "platforms": ["android"],
    "android": {
      "package": "com.sice.operador",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://sice-backend-production.up.railway.app",
      "apiUrlDev": "http://10.0.2.2:4000"
    }
  }
}
