{
  "expo": {
    "name": "SICE Operador",
    "slug": "sice-operador",
    "version": "1.24.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sice",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "owner": "santiquirogamolina",
    "android": {
      "package": "com.sice.operador",
      "versionCode": 32,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/icon-mono.png",
        "backgroundColor": "#0D1B2A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "SICE necesita la cámara para tomar foto del documento como evidencia probatoria de la entrega."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SICE captura tu ubicación al momento de registrar la entrega como evidencia de campo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://sice-backend-production.up.railway.app",
      "apiUrlDev": "http://10.0.2.2:4000",
      "router": {},
      "eas": {
        "projectId": "18b90edd-7dbc-41e6-9c8e-84ee80b1b85f"
      }
    },
    "updates": {
      "enabled": false
    }
  }
}
